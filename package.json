{
  "name": "tuna-reportes-api",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "module": "src/index.ts",
  "types": "src/types/rpc.ts",
  "exports": {
    ".": {
      "types": "./src/types/rpc.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src/index.ts",
    "src/types",
    "src/app",
    "src/routers",
    "src/schemas",
    "src/constants",
    "src/middlewares"
  ],
  "scripts": {
    "postinstall": "node -e \"if (require('fs').existsSync('.git')) require('child_process').execSync('husky', {stdio: 'inherit'})\"",
    "dev": "bun --watch src/index.ts",
    "test": "bun test --env-file .env",
    "test:watch": "bun test --watch --env-file .env",
    "prepare": "husky",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "db:migrate": "npx drizzle-kit migrate",
    "db:drop": "npx drizzle-kit drop",
    "db:generate": "npx drizzle-kit generate",
    "db:studio": "npx drizzle-kit studio",
    "db:seed": "bun src/scripts/seed.ts",
    "db:clean": "bun src/scripts/clean.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.8.2",
    "hono": "^4.7.5",
    "postgres": "^3.4.7",
    "zod": "^3.25.20"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@faker-js/faker": "^10.1.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "tsx": "^4.19.4"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
